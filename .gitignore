node_modules/
dist/

# A local native app project (Capacitor) is not part of this repository. Without this line git
# would list every Xcode/Gradle build file in it, hiding real changes.
app/
.env
*.log
.DS_Store
.playwright-mcp/
/*.png
secrets/

# Local development-tool configuration (skills/prompts); not part of the project.
.claude/
# Untracked working documents, listed so that `git add -A` cannot pick them up. Debug
# screenshots are already covered by `/*.png`.
*.pdf

# npm cache directory used by CI (`npm ci --cache .npm`). Never belongs in a commit, and listing it
# here also keeps local tooling that walks the working tree from tripping over it.
.npm/

# Local environment variants. The templates are tracked.
.env.*
!.env.example
!.env.selfhost.example

# Keys and certificates. The only one that belongs in the repository is Apple's public
# intermediate certificate for wallet passes.
*.pem
*.key
*.p12
*.pfx
!assets/pass/AppleWWDRCAG4.pem

# Runtime data of a local run (Pro audit trail, QES demo CA) and operator pages kept next to the
# compose file (EUDI_OPERATOR_PAGES).
/data/
/pages/

# Editors and IDEs
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Operating systems
._*
Thumbs.db
desktop.ini

# Build, test and tool caches
*.tsbuildinfo
coverage/
.nyc_output/
.eslintcache
.cache/
npm-debug.log*
