# Self-hosting env for docker-compose.yml — copy to `.env` and fill in.
# Do NOT commit the filled-in .env (it holds secrets).

# --- public identity ---
# Your domain (must have an A/AAAA record pointing at this host BEFORE `up`, so
# Let's Encrypt can issue a cert).
DOMAIN=call.example.org
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.org

# --- TURN (coturn) ---
# Long random shared secret for TURN-REST credentials. Generate one:
#   openssl rand -hex 32
TURN_SECRET=change-me-openssl-rand-hex-32
# The server's PUBLIC IP (coturn advertises this as the relay address).
#   curl -s https://api.ipify.org
TURN_EXTERNAL_IP=203.0.113.10

# --- edition ---
# community (default) or pro. Community is the full 1:1 product — screen sharing, mute/camera,
# spotlight, hand raise, file transfer, emoji, calendar invites, Apple Wallet pass, iframe
# embedding and in-call credential requests are all included. `pro` adds three things:
# audit-trail (retainable record), multi-party (mesh beyond two) and qes-csc (qualified
# signature via a QTSP) — these need a commercial licence (LICENSE-COMMERCIAL.md).
# Individual capabilities can be switched off with EUDI_FEATURES_OFF (see .env.example).
EUDI_EDITION=community

# --- EUDIPLO verifier ---
# YOUR OWN EUDIPLO instance — this application ships no verifier and cannot work without one.
# What you need (see README for the walkthrough):
#   - EUDIPLO 6.2.0, PINNED, not :latest — the 5→6 jump is a breaking change
#   - its own subdomain with TLS: the wallet contacts the verifier directly
#   - an ACCESS CERTIFICATE from a registration authority, issued for that hostname
#     (in Germany: the German Registrar). Allow weeks for this — it is an application,
#     not a download, and without it real wallets refuse the request.
#   - VP_REMOVE_TA=true on the instance, or wallets that reject `trusted_authorities` fail
# For frontend work only there is a dummy without cryptography (`--profile mock`,
# http://mock-eudiplo:8080). It is NOT a verifier: it also returns data that was never
# requested, so protocol errors stay invisible. Never point a real deployment at it.
EUDIPLO_BASE_URL=https://verifier.example.org
EUDIPLO_ROOT_ID=your-root-id
EUDIPLO_ROOT_SECRET=__set_me__
EUDIPLO_CLIENT_ID=your-tenant-id
VERIFIER_REQUEST_ID=pid_full_verifier
VERIFIER_CLIENT_ID=eudi.example.org
